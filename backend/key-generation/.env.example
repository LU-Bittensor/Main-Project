# Copy to .env in this directory. The real-account launcher loads it.
# Must match health-locker-guard VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_URL=
# Auth verification (same project as the frontend). Required unless grant_api --dev.
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret from the SAME Supabase project. Never use a VITE_ variable.
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=

# Epic Sandbox app's non-production client ID (not your Epic login).
EPIC_CLIENT_ID=
# Must exactly match a redirect URI registered for that app.
# This future frontend callback must POST code/state with the Medilink session
# to an authenticated completion endpoint. Neither callback is implemented yet.
EPIC_REDIRECT_URI=http://127.0.0.1:5173/external-import/callback

# Enable only after applying 20261026120000_hippius_storage.sql.
DOCUMENT_STORAGE_BACKEND=supabase
# DOCUMENT_STORAGE_BACKEND=hippius
# Local development without cloud storage (browser ciphertext only):
# DOCUMENT_STORAGE_BACKEND=local
# Stored in GRANT_DATA_DIR/local-documents.sqlite3; keep GRANT_DATA_DIR private and persistent.
HIPPIUS_ACCESS_KEY_ID=
HIPPIUS_SECRET_ACCESS_KEY=
HIPPIUS_NAMESPACE=medilink-local
# Two independent persistent 32-byte hex keys. Generate once; back up securely.
# python -c 'import secrets; print(secrets.token_hex(32))'
HIPPIUS_PATIENT_HASH_KEY=
HIPPIUS_STORAGE_MASTER_KEY=

# Optional: override local vault keystore directory (default GRANT_DATA_DIR/vault_objects).
# Survives --auto-data-dir Hardhat instance shards; do not put this under a fingerprint child.
# GRANT_VAULT_DIR=

# Local Hardhat / Subtensor EVM (also set by load_API_bc*.sh for Hardhat).
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
# OWNER_PRIVATE_KEY=

# MediLink faucet (after: python deploy_medilink_faucet.py). See markdowns/Faucet.md.
# FAUCET_ADDRESS=
# FAUCET_OPERATOR_PRIVATE_KEY=   # defaults to OWNER_PRIVATE_KEY
# FAUCET_MIN_BALANCE=5000000000000000

# CORS allowlist for the browser app (Vite 5173 / Lovable 8080 by default).
# FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

