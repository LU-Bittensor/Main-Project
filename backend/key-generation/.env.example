# Copy to .env in this directory. The real-account launcher loads it.
SUPABASE_URL=https://cwyxwmzquatqlbufsdob.supabase.co
# Server-only secret from the SAME Supabase project. Never use a VITE_ variable.
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=

# Epic Sandbox app's non-production client ID (not your Epic login).
EPIC_CLIENT_ID=
# Must exactly match a redirect URI registered for that app.
# This future frontend callback must POST code/state with the Medilink session
# to an authenticated completion endpoint. Neither callback is implemented yet.
EPIC_REDIRECT_URI=http://127.0.0.1:5173/external-import/callback
