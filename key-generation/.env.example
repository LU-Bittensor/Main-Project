# Copy to .env (do not commit secrets) or export in your shell.
# Subtensor EVM testnet (945) defaults — change for Hardhat (31337) or mainnet (964).

RPC_URL=https://test.chain.opentensor.ai
CHAIN_ID=945
EVM_RPC_URL=https://test.chain.opentensor.ai
EVM_CHAIN_ID=945

# Funded H160 private keys (NOT Bittensor coldkeys)
OWNER_PRIVATE_KEY=0xYOUR_OWNER_KEY
USER_PRIVATE_KEY=0xYOUR_USER_KEY

# Filled after: python key-generation/deploy_access_registry.py
# Multi-grantee AccessRegistry requires a fresh deploy (breaking ABI).
CONTRACT_ADDRESS=
ACCESS_REGISTRY=
EVM_START_BLOCK=0

# Optional demo resource metadata (prefer Hippius payload key as dataCid)
DATA_CID=ehr/demo/patient/record/v1/payload.bin

# Optional Hippius S3 (gateway holds hip_ keys). If unset, ehr_hippius.py uses local .ehr_local/
HIPPIUS_ACCESS_KEY=
HIPPIUS_SECRET_KEY=
HIPPIUS_BUCKET=
HIPPIUS_KEY=
URL_EXPIRATION=300
EHR_LOCAL_DIR=
DH_PASSPHRASE=demo-passphrase
