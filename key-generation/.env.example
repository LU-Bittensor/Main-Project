# Copy to .env (do not commit secrets) or export in your shell.
# Subtensor EVM testnet (945) defaults — change for Hardhat (31337) or mainnet (964).

RPC_URL=https://test.chain.opentensor.ai
CHAIN_ID=945
EVM_RPC_URL=https://test.chain.opentensor.ai
EVM_CHAIN_ID=945

# Funded H160 private keys (NOT Bittensor coldkeys)
# OWNER: deploy AccessRegistry + MediLinkFaucet, deposit into faucet
# USER: CLI/demo grantee only (product path uses browser vault keys)
OWNER_PRIVATE_KEY=0xYOUR_OWNER_KEY
USER_PRIVATE_KEY=0xYOUR_USER_KEY

# Filled after: python key-generation/deploy_access_registry.py
# Multi-grantee AccessRegistry requires a fresh deploy (breaking ABI).
CONTRACT_ADDRESS=
ACCESS_REGISTRY=
EVM_START_BLOCK=0

# MediLink faucet (python key-generation/deploy_medilink_faucet.py)
FAUCET_ADDRESS=
# Operator key that calls drip(); defaults to OWNER_PRIVATE_KEY if unset
FAUCET_OPERATOR_PRIVATE_KEY=
# Optional constructor / client tuning (wei)
# FAUCET_DRIP_AMOUNT=10000000000000000
# FAUCET_MIN_BALANCE=5000000000000000
# FAUCET_COOLDOWN=86400

# wallet_api.py
GRANT_DATA_DIR=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional demo resource metadata (prefer Hippius payload key as dataCid)
DATA_CID=ehr/demo/patient/record/v1/payload.bin

# Optional Hippius S3 (gateway holds hip_ keys). If unset, ehr_hippius.py uses local .ehr_local/
HIPPIUS_ACCESS_KEY=
HIPPIUS_SECRET_KEY=
HIPPIUS_BUCKET=
HIPPIUS_KEY=
URL_EXPIRATION=300
EHR_LOCAL_DIR=
DH_PASSPHRASE=demo-passphrase
